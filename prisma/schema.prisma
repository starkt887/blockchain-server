//create, read, edit, delete
//syntax <Table_name>-<permission_num_sequence> 
//e.g. User-0000 (role has no access to users)
//e.g. User-1111 (role has full access to users)
model Roles {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  title       String @unique
  permissions String
  User        User[]
}

model User {
  id                  String                @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  email               String                @unique
  password            String
  company             String?
  logo                String?
  country             String?
  countryCode         String?
  city                String?
  zipcode             String?
  state               String?
  mobile              String                @unique
  apiKey              String? //on activating the license
  apiExpiry           DateTime? //on activating the license
  smcAddress          String? //on activating the license
  refreshToken        String?
  TransactionRequests TransactionRequests[]
  roleId              String                @db.ObjectId
  role                Roles                 @relation(fields: [roleId], references: [id])
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
}

model TransactionRequests {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  metadata  String
  status    String
  txhash    String
  from      String
  to        String
  response  String
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

